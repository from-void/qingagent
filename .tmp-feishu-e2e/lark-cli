#!/usr/bin/env node
import { readFileSync, writeFileSync } from "node:fs";

const statePath = process.env.LARK_STUB_STATE;
if (!statePath) throw new Error("LARK_STUB_STATE is required");
const readState = () => JSON.parse(readFileSync(statePath, "utf8"));
const writeState = (state) => writeFileSync(statePath, `${JSON.stringify(state)}\n`);
const args = process.argv.slice(2);

if (args[0] === "--version") {
  process.stdout.write("lark-cli version 1.0.65\n");
  process.exit(0);
}

const state = readState();
if (args.join(" ") === "config show") {
  process.stdout.write(`${JSON.stringify({ appId: state.configured ? "cli_e2e_app" : null, brand: "feishu" })}\n`);
} else if (args.join(" ") === "config init --new --brand feishu --lang zh") {
  state.configured = true;
  writeState(state);
  process.stdout.write("创建应用: https://open.feishu.cn/verification/e2e-app\n");
} else if (args.join(" ") === "auth status --json") {
  process.stdout.write(`${JSON.stringify({ identities: { user: {
    available: state.connected,
    status: state.connected ? "ready" : "missing",
    userName: state.connected ? "E2E 用户" : undefined,
    openId: state.connected ? "ou_e2e" : undefined,
    scopes: state.scopes,
  } } })}\n`);
} else if (args[0] === "auth" && args[1] === "login" && args.includes("--no-wait")) {
  const domains = args[args.indexOf("--domain") + 1].split(",");
  state.pendingDomains = domains;
  writeState(state);
  process.stdout.write(`${JSON.stringify({
    verification_url: "https://accounts.feishu.cn/device",
    user_code: "E2E-SCAN",
    device_code: "stub-device-code-internal-only",
    expires_in: 300,
  })}\n`);
} else if (args[0] === "auth" && args[1] === "login" && args.includes("--device-code")) {
  state.connected = true;
  state.scopes = [...new Set([...(state.scopes ?? []), ...(state.pendingDomains ?? [])])];
  state.pendingDomains = [];
  writeState(state);
} else if (args.join(" ") === "auth logout") {
  state.connected = false;
  state.scopes = [];
  state.pendingDomains = [];
  writeState(state);
} else {
  process.stderr.write("stub command rejected\n");
  process.exit(17);
}
