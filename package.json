{
  "name": "qingagent",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @qingagent/web dev",
    "dev:server": "pnpm --filter @qingagent/server dev",
    "dev:desktop": "pnpm --filter @qingagent/desktop dev",
    "build:desktop": "pnpm --filter @qingagent/web build && pnpm --filter @qingagent/desktop build",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:heavy": "pnpm -r --workspace-concurrency=1 --if-present test:heavy",
    "test:perf": "pnpm -r --workspace-concurrency=1 --if-present test:perf",
    "test:all": "pnpm test && pnpm test:heavy && pnpm test:perf",
    "typecheck": "pnpm -r --if-present typecheck",
    "depcruise": "dependency-cruise packages/*/src apps/*/src --config .dependency-cruiser.cjs",
    "test:depcruise-guard": "node --test scripts/dependency-cruiser-guard.test.mjs",
    "scorers": "tsx scripts/run-scorers.mts",
    "scorers:live": "tsx scripts/run-live-scorers.mts",
    "pm:schema:check": "pnpm --filter @qingagent/pm-schema test -- schemaSync",
    "pm:roundtrip": "pnpm --filter @qingagent/pm-schema test -- pmMarkdownRoundTrip aiIrRoundTrip && pnpm --filter @qingagent/web test:dom -- pmRoundTrip",
    "pm:migrate:check": "pnpm --filter @qingagent/pm-schema test -- legacyMigration",
    "pm:impact:check": "node scripts/pm-impact-check.mjs",
    "pm:legacy-ban": "node scripts/pm-legacy-ban.mjs",
    "pm:image:check": "node scripts/pm-image-check.mjs",
    "pm:history:check": "node scripts/pm-history-check.mjs",
    "pm:commit:check": "pnpm --filter @qingagent/core test -- commitDocumentOp",
    "db:restore-quarantine-0002": "node --import ./packages/server/node_modules/tsx/dist/loader.mjs packages/db/scripts/restore-quarantine-0002.mts",
    "db:identify-quarantine-0002-overwrites": "node --import ./packages/server/node_modules/tsx/dist/loader.mjs packages/db/scripts/identify-quarantine-0002-overwrites.mts",
    "pm:css:check": "node scripts/pm-css-check.mjs",
    "lint:skills": "node scripts/check-skill-scripts.mjs",
    "export:matrix": "pnpm --filter @qingagent/doc-render test -- export-format-matrix",
    "external-contract:generate": "pnpm --filter @qingagent/contract-ts generate:external",
    "external-contract:check": "pnpm --filter @qingagent/contract-ts check:external",
    "eval:role-review": "node --import ./packages/server/node_modules/tsx/dist/loader.mjs scripts/evaluate-role-recommendation.mts"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.0.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "22.20.1"
    }
  },
  "license": "MIT"
}
