{
  "name": "chinese-masonry",
  "version": "0.1.0",
  "description": "中国风瀑布流 React 组件库，包含固定 290px 卡片、模板系统、约束式模板编辑器和 Demo。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "module": "./dist/chinese-masonry.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chinese-masonry.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "masonic": "3.7.0",
    "react-colorful": "^5.6.1",
    "zustand": "^4.5.7"
  }
}
