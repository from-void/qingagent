# qingagent server 本地密钥/配置示例
#
# 复制本文件为 packages/server/.env 并填入你的 key(真实 .env 不入库,已被 .gitignore 忽略):
#   cp packages/server/.env.example packages/server/.env   # 然后编辑填 key

# ---- 默认模型(主基模) ----
# key:visitor(浏览器) > global-db(设置页) > env(此处),三层兜底。
DEEPSEEK_API_KEY=

# DeepSeek 峰谷价尚未正式生效，默认关闭；窗口按北京时间解释并采用 [start,end)。
# DEEPSEEK_PEAK_PRICING_JSON={"enabled":false,"multiplier":2,"windows":[{"start":"09:00","end":"12:00"},{"start":"14:00","end":"18:00"}]}

# 浏览器自动化基模(scrapeWithBrowser 等);留空则禁用。
QINGAGENT_AGENT_BROWSER=

# ---- 服务监听与公网安全（可选；非回环部署前必须阅读 README 安全声明） ----
# server 默认只监听 127.0.0.1:8080。PORT 在 Vite 进程中也会被当作 Web 端口兜底；
# 并行开发请用 QINGAGENT_WEB_PORT 单独覆盖前端端口，避免与 server 共用 PORT。
# PORT=8080
# QINGAGENT_WEB_PORT=6173
# QINGAGENT_HOST=127.0.0.1

# 非回环监听必须设置强随机共享 token；不要用无鉴权公网逃生开关。
# QINGAGENT_AUTH_TOKEN=<openssl rand -hex 32 的输出>
# QINGAGENT_ALLOW_UNAUTHENTICATED_PUBLIC=0
# QINGAGENT_PUBLIC_DEPLOYMENT=1

# 公网反代时必须配置完整、精确的前端 Origin（含协议，非裸 Host）；多个值用逗号分隔。
# QINGAGENT_TRUSTED_ORIGINS=https://qingagent.example.com

# ---- 公网反代导出链接（可选） ----
# 推荐固定成站点公网 origin；服务端导出 Markdown 时会用它绝对化 /api/ 媒体链接。
# QINGAGENT_PUBLIC_ORIGIN=https://qing.example.com
# 仅当入口反代会剥离客户端伪造的 X-Forwarded-* 头并重写可信值时才开启。
# QINGAGENT_TRUST_PROXY=1

# debug/dataAdmin 路由默认关闭；不要在公网无 token 时开启。
# QINGAGENT_ENABLE_DEBUG=0

# 浏览器走 HTTP(S)_PROXY 时，代理必须在连接层阻断私网/环回/链路本地/云元数据，
# 并用此变量确认；否则代理浏览器会 fail-closed。
# QINGAGENT_BROWSER_PROXY_ACL=deny-private

# server 形态下以下高危能力默认关闭，仅显式 =1 开启。桌面主进程会在未设置时补成 1；
# 如需收紧桌面能力请显式设 0。切勿把这组桌面默认直接带到外部可达部署。
# QINGAGENT_ALLOW_UNISOLATED_COMMANDS=0
# QINGAGENT_SANDBOX_INJECT_CREDENTIALS=0
# QINGAGENT_ALLOW_SKILL_MUTATION=0

# 观察记忆与压缩缺省开启，会产生额外观察模型调用与费用；不接受时请显式关闭。
# QINGAGENT_OM_SIDECAR=0
# QINGAGENT_OM_COMPRESS=0
# QINGAGENT_OM_COMPRESS_THRESHOLD_TOKENS=500000

# Python 沙箱在 server 形态默认关闭、桌面形态默认开启；瘦桌面包无资源时仍不可用。
# QINGAGENT_PYODIDE_ENABLED=0

# ---- 切换到 GLM / 其他 anthropic 协议厂商(可选) ----
# 把以下四项一起填好,即让"该机/该 worktree 默认走 GLM"。访客在浏览器里自定义的
# endpoint 仍以更高优先级覆盖它(env 只是默认底座)。GLM Coding 用 anthropic 协议。
#   1) 上面的 DEEPSEEK_API_KEY 填 GLM 的 key
#   2) baseURL 指向 GLM 中转(anthropic 入口,程序会自动补 /v1)
# QINGAGENT_DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   3) 协议设为 anthropic
# QINGAGENT_MODEL_PROTOCOL=anthropic
#   4) 模型名换成 GLM 的(flash 为主调用档,pro 备用)
# QINGAGENT_MODEL_FLASH=glm-4.6
# QINGAGENT_MODEL_PRO=glm-4.6

# 私网模型网关默认被 SSRF 策略拒绝；仅自部署且确认目标可信时才打开。Ollama/LM Studio
# 使用 localhost、127.0.0.1 或 [::1] 无需此开关。
# QINGAGENT_ALLOW_PRIVATE_MODEL_HOST=1
