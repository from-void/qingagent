{
  "name": "@qingagent/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./crashGuard": "./src/crashGuard.ts",
    "./desktopShutdown": "./src/desktopShutdown.ts",
    "./src/app": "./src/app.ts",
    "./desktopFolderSelection": "./src/lib/desktopFolderSelection.ts",
    "./externalInstance": "./src/lib/externalInstance.ts",
    "./libraryIdentity": "./src/lib/libraryIdentity.ts",
    "./attachPolicy": "./src/lib/attachPolicy.ts",
    "./commandRequestHeaders": "./src/lib/commandRequestHeaders.ts",
    "./authCredentials": "./src/lib/authCredentials.ts",
    "./httpDispatcher": "./src/lib/httpDispatcher.ts",
    "./confirmUiGrant": "./src/lib/confirmUiGrant.ts"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--use-env-proxy' tsx watch src/index.ts",
    "start": "NODE_OPTIONS='--use-env-proxy' tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:heavy": "vitest run --config vitest.heavy.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@mastra/core": "^1.49.0",
    "@mastra/duckdb": "^1.5.0",
    "@mastra/libsql": "^1.15.0",
    "@mastra/observability": "^1.15.2",
    "@qingagent/contract-ts": "workspace:*",
    "@qingagent/core": "workspace:*",
    "@qingagent/db": "workspace:*",
    "@qingagent/doc-render": "workspace:*",
    "@qingagent/pm-schema": "workspace:*",
    "dotenv": "^16.4.7",
    "hono": "^4.7.10",
    "jszip": "^3.10.1",
    "undici": "^8.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@qingagent/diagram-engine": "workspace:*",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "license": "MIT"
}
