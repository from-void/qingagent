{
  "name": "@qingagent/ui-kit",
  "version": "0.1.0",
  "description": "青简设计 token 与基础样式的唯一来源，附带少量已消费的原始组件；非完整 React 组件库。",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.ts"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./components.css": "./src/components.css"
  },
  "scripts": {
    "test": "node --import tsx src/Modal.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "18.3.5",
    "react": "18.3.1"
  },
  "license": "MIT"
}
